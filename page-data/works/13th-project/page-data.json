{"componentChunkName":"component---src-templates-project-template-js","path":"/works/13th-project/","result":{"data":{"markdownRemark":{"html":"<div class=\"content-section project-content project-content--7/3\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Project background</b>\n      <h3 class=\"h3\">The challenge</h3>\n    </header>\n    <dl>\n      <dt>Product issue</dt>\n      <dd>\n        Map discovery gave users freedom but lacked a clear starting point, leading to low engagement.\n      </dd>\n      <dt>Product goal</dt>\n      <dd>\n        Increase profile views and engagement by helping users discover relevant people more easily.\n      </dd>\n      <dt>Design challenge</dt>\n      <dd>\n        How might we guide users toward meaningful connections without taking away their freedom to explore?\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--1\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 375px; \">\n      <a class=\"gatsby-resp-image-link\" href=\"/static/a4e3b498bd5f6fa2245e24122f3215c0/5ff7e/project01.png\" style=\"display: block\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.66666666666666%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/a4e3b498bd5f6fa2245e24122f3215c0/5ff7e/project01.png\" srcset=\"/static/a4e3b498bd5f6fa2245e24122f3215c0/5a46d/project01.png 300w,\n/static/a4e3b498bd5f6fa2245e24122f3215c0/5ff7e/project01.png 375w\" sizes=\"(max-width: 375px) 100vw, 375px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n  </a>\n    </span>\n      <figcaption>Fig.1: More isn't always better</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #1</b>\n      <h3 class=\"h3\">Exploring: Finding direction in an open map</h3>\n    </header>\n    <p class=\"mb-8\">\n      Explore why an open map can feel aimless, and how clearer starting points and contextual cues could help.\n    </p>\n    <ul class=\"bulleted-list\">\n      <li>Too many or too few people nearby.</li>\n      <li>Little context beyond a single photo.</li>\n      <li>Often the same people users saw yesterday.</li>\n    </ul>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--landscape project-content__image--block\">\n    <div class=\"project-content__figure\" \"=\"\">\n      <dl class=\"mb-4\">\n        <dt>Option 1. Browsing feed</dt>\n        <dd>\n          <ul class=\"bulleted-list\">\n            <li>Curated profiles ordered by proximity.</li>\n            <li>Key profile information and actionable buttons at a glance.</li>\n          </ul>\n        </dd>\n      </dl>\n      <figure class=\"project-content__figure\">\n        <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1200px; \">\n      <a class=\"gatsby-resp-image-link\" href=\"/static/acc08bc2228cdd9dfd7f782f58dcc384/a3a5c/explor01.png\" style=\"display: block\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 68.66666666666667%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/acc08bc2228cdd9dfd7f782f58dcc384/c1b63/explor01.png\" srcset=\"/static/acc08bc2228cdd9dfd7f782f58dcc384/5a46d/explor01.png 300w,\n/static/acc08bc2228cdd9dfd7f782f58dcc384/0a47e/explor01.png 600w,\n/static/acc08bc2228cdd9dfd7f782f58dcc384/c1b63/explor01.png 1200w,\n/static/acc08bc2228cdd9dfd7f782f58dcc384/a3a5c/explor01.png 1277w\" sizes=\"(max-width: 1200px) 100vw, 1200px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n  </a>\n    </span>\n        <figcaption>Fig.2: Browsing feed</figcaption>\n      </figure>\n    </div>\n    <div class=\"project-content__figure\" \"=\"\">\n      <dl class=\"mb-4\">\n        <dt>Option 2. Focused browsable carousel</dt>\n        <dd>\n          <ul class=\"bulleted-list\">\n            <li>Curated profiles ordered by proximity.</li>\n            <li>Profile highlight with full-profile access</li>\n          </ul>\n        </dd>\n      </dl>\n      <figure class=\"project-content__figure\">\n        <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1200px; \">\n      <a class=\"gatsby-resp-image-link\" href=\"/static/6ec337a3de8ed93acdefd522bca60e49/a3a5c/explor02.png\" style=\"display: block\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 68.66666666666667%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/6ec337a3de8ed93acdefd522bca60e49/c1b63/explor02.png\" srcset=\"/static/6ec337a3de8ed93acdefd522bca60e49/5a46d/explor02.png 300w,\n/static/6ec337a3de8ed93acdefd522bca60e49/0a47e/explor02.png 600w,\n/static/6ec337a3de8ed93acdefd522bca60e49/c1b63/explor02.png 1200w,\n/static/6ec337a3de8ed93acdefd522bca60e49/a3a5c/explor02.png 1277w\" sizes=\"(max-width: 1200px) 100vw, 1200px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n  </a>\n    </span>\n        <figcaption>Fig.3: Browsable carousel</figcaption>\n      </figure>\n    </div>\n    <div class=\"project-content__figure\" \"=\"\">\n      <dl class=\"mb-4\">\n        <dt>Option 3. Zoomed-In 3D Navigation</dt>\n        <dd>\n          <ul class=\"bulleted-list\">\n            <li>Zoom in on one profile at a time.</li>\n            <li>Explore a heads-up display (HUD) for profile highlights.</li>\n          </ul>\n        </dd>\n      </dl>\n      <figure class=\"project-content__figure\">\n        <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1200px; \">\n      <a class=\"gatsby-resp-image-link\" href=\"/static/a83917465cb8ced7e0852ec78e79cb80/a3a5c/explor03.png\" style=\"display: block\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 68.66666666666667%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/a83917465cb8ced7e0852ec78e79cb80/c1b63/explor03.png\" srcset=\"/static/a83917465cb8ced7e0852ec78e79cb80/5a46d/explor03.png 300w,\n/static/a83917465cb8ced7e0852ec78e79cb80/0a47e/explor03.png 600w,\n/static/a83917465cb8ced7e0852ec78e79cb80/c1b63/explor03.png 1200w,\n/static/a83917465cb8ced7e0852ec78e79cb80/a3a5c/explor03.png 1277w\" sizes=\"(max-width: 1200px) 100vw, 1200px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n  </a>\n    </span>\n        <figcaption>Fig.4: Zoomed-in 3D navigation</figcaption>\n      </figure>\n    </div>\n  </div>\n</div>\n<div class=\"content-section project-content project-content--4/6 project-content--flipped\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #2</b>\n      <h3 class=\"h3\">Re-routing: Measuring focus and freedom</h3>\n    </header>\n    <p>\n      Reduce distractions without sacrificing the freedom to explore.\n      <b class=\"block\">↳ Introduce a hybrid map discovery model with Focus Mode.</b>\n    </p>\n    <dl>\n      <dt>Focuse mode</dt>\n      <dd>\n        <b>One proflie at a time:</b> A focused discovery flow with actionable profile previews.\n      </dd>\n      <dt>Exit anytime</dt>\n      <dd>\n        <b>Stay in control:</b> Users can leave the focused flow and continue exploring map freely.\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--2\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 419px; \">\n      <a class=\"gatsby-resp-image-link\" href=\"/static/5b891ebbde9733d58d31e1505038a301/d587d/project02.png\" style=\"display: block\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 209.66666666666666%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/5b891ebbde9733d58d31e1505038a301/d587d/project02.png\" srcset=\"/static/5b891ebbde9733d58d31e1505038a301/5a46d/project02.png 300w,\n/static/5b891ebbde9733d58d31e1505038a301/d587d/project02.png 419w\" sizes=\"(max-width: 419px) 100vw, 419px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n  </a>\n    </span>\n      <figcaption>Fig.3: Focus mode</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 419px; \">\n      <a class=\"gatsby-resp-image-link\" href=\"/static/d877a132742da0a6cfe5eaeba587ef29/d587d/project03.png\" style=\"display: block\" target=\"_blank\" rel=\"noopener\">\n    <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 209.66666666666666%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/d877a132742da0a6cfe5eaeba587ef29/d587d/project03.png\" srcset=\"/static/d877a132742da0a6cfe5eaeba587ef29/5a46d/project03.png 300w,\n/static/d877a132742da0a6cfe5eaeba587ef29/d587d/project03.png 419w\" sizes=\"(max-width: 419px) 100vw, 419px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n  </a>\n    </span>\n      <figcaption>Fig.4: Exiting to map</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content project-content--6/4\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #3</b>\n      <h3 class=\"h3\">Re-targeting: Tuning the goal-oriented UX</h3>\n    </header>\n    <p>\n      Go deep to connect, or go wide to explore <b>- one at a time.</b>\n    </p>\n    <dl>\n      <dt>Focus mode layout option</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Option A — Photo-First: Prioritize profile photos and compatibility signals.</li>\n          <li>Option B — Editorial: Prioritize profile content through an editorial layout.</li>\n        </ul>\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--2\">\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/84b23914e48ff78bf6835b2e70964627/project04.gif\" alt=\"Project\">\n      <figcaption>Fig.5: Option A</figcaption>\n    </figure>\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/426a3b15703c0e751f7d716f2ab5c444/project05.gif\" alt=\"Project\">\n      <figcaption>Fig.6: Option B</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #4</b>\n      <h3 class=\"h3\">Final design: Focus Mode with the freedom to exit</h3>\n    </header>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--block\">\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/4806065860ede87a998a3804a722d3cf/project06.gif\" alt=\"Project\">\n      <figcaption>Fig.7: Feature adoption</figcaption>\n    </figure>\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/db3f6f0c8df6063db3532e12fa34b764/project07.gif\" alt=\"Project\">\n      <figcaption>Fig.6: Introducing Focus Mode</figcaption>\n    </figure>\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/2895f9b80315c5bba7ef807332423faf/project08.gif\" alt=\"Project\">\n      <figcaption>Fig.6: Exploring profiles in Focus Mode</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Learnings</b>\n      <h3 class=\"h3\">\"Have options, not distractions\"</h3>\n    </header>\n    <div class=\"project-content__card\">\n      <p>\n        More options without mindful guadience, are distraction. The key is to give users enough direction to take the next step, while keeping them in control of where they go.\n      </p>\n      <p>\n        Good discovery isn't about showing users everything. It's about helping them find what matters to them.\n      </p>\n    </div>\n  </div>\n</div>","frontmatter":{"date":"May, 2025","slug":"/works/13th-project","title":"Guided Discover over the Map","tags":["Product Discovery","User Interface","User Experience","Prototyping","Micro Interaction","@Match Group"],"impacts":["<strong>19%</strong> ⬆️ DAU","<strong>2%</strong> ⬆️ NDR","<strong>28%</strong> ⬆️ Profile Views","<strong>3%</strong> ⬆️ Outgoing Attention","<strong>6%</strong> ⬆️ 6-Way Convo"],"excerpt":"Making map discover experience more guided, relevant, and engaging.","team":"Archer","teamUrl":"https://www.archerapp.com/","role":"Lead Product Designer","industry":"Online Dating","headerFlip":true,"previewLandscape":false,"cover":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#f86868","images":{"fallback":{"src":"/static/3260cef65eb5435e3990a27b783eed40/b92ff/project-cover.png","srcSet":"/static/3260cef65eb5435e3990a27b783eed40/4b1e5/project-cover.png 150w,\n/static/3260cef65eb5435e3990a27b783eed40/a061f/project-cover.png 300w,\n/static/3260cef65eb5435e3990a27b783eed40/b92ff/project-cover.png 600w","sizes":"(min-width: 600px) 600px, 100vw"},"sources":[{"srcSet":"/static/3260cef65eb5435e3990a27b783eed40/ca576/project-cover.webp 150w,\n/static/3260cef65eb5435e3990a27b783eed40/a9a8c/project-cover.webp 300w,\n/static/3260cef65eb5435e3990a27b783eed40/5765c/project-cover.webp 600w","type":"image/webp","sizes":"(min-width: 600px) 600px, 100vw"}]},"width":600,"height":340}}},"preview":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#585858","images":{"fallback":{"src":"/static/aae889e94c49b101bb85f3be27d0cdb1/2ba20/project-preview.png","srcSet":"/static/aae889e94c49b101bb85f3be27d0cdb1/cf9e6/project-preview.png 150w,\n/static/aae889e94c49b101bb85f3be27d0cdb1/fd946/project-preview.png 300w,\n/static/aae889e94c49b101bb85f3be27d0cdb1/2ba20/project-preview.png 600w,\n/static/aae889e94c49b101bb85f3be27d0cdb1/7961f/project-preview.png 1200w","sizes":"(min-width: 600px) 600px, 100vw"},"sources":[{"srcSet":"/static/aae889e94c49b101bb85f3be27d0cdb1/d9fd3/project-preview.webp 150w,\n/static/aae889e94c49b101bb85f3be27d0cdb1/3299a/project-preview.webp 300w,\n/static/aae889e94c49b101bb85f3be27d0cdb1/38e3a/project-preview.webp 600w,\n/static/aae889e94c49b101bb85f3be27d0cdb1/ee6d9/project-preview.webp 1200w","type":"image/webp","sizes":"(min-width: 600px) 600px, 100vw"}]},"width":600,"height":989}}}}}},"pageContext":{"slug":"/works/13th-project"}},"staticQueryHashes":[],"slicesMap":{}}