{"componentChunkName":"component---src-templates-project-template-js","path":"/works/1st-project/","result":{"data":{"markdownRemark":{"html":"<div class=\"content-section project-content project-content--6/4\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <h3 class=\"h3\">The challenge</h3>\n    </header>\n    <dl>\n      <dt>Product issue</dt>\n      <dd>\n        High bounce rate from landing screen (Fig.1)\n      </dd>\n      <dt>User Test Finding</dt>\n      <dd>\n        \"I don't see what I can do...\" (Search)\n      </dd>\n      <dt>Product goal</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Increase flight search rate</li>\n          <li>Reduce bounce rate</li>\n        </ul>\n      </dd>\n      <dt>Design challenge</dt>\n      <dd>\n        HMW make flight search immediately understandable without taking over the entire screen\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--2\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/bb8d1896cb0410e9c3b7a3d41d5579d1/1d69c/project01.png\" srcset=\"/static/bb8d1896cb0410e9c3b7a3d41d5579d1/5a46d/project01.png 300w,\n/static/bb8d1896cb0410e9c3b7a3d41d5579d1/0a47e/project01.png 600w,\n/static/bb8d1896cb0410e9c3b7a3d41d5579d1/1d69c/project01.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.1: Landing screen</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/501a1a36eede25e7c4ae36e852a31fa2/1d69c/project02.png\" srcset=\"/static/501a1a36eede25e7c4ae36e852a31fa2/5a46d/project02.png 300w,\n/static/501a1a36eede25e7c4ae36e852a31fa2/0a47e/project02.png 600w,\n/static/501a1a36eede25e7c4ae36e852a31fa2/1d69c/project02.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.2: Search screen</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content project-content--3/7 project-content--flipped\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #1</b>\n      <h3 class=\"h3\">Reframing the problem</h3>\n    </header>\n    <p>\n      Search needed to be obvious, but it couldn't own the entire screen.\n      <b class=\"block\">↳ How much of the screen should search occupy?</b>\n    </p>\n    <dl>\n      <dt>Flight search</dt>\n      <dd>Help users understand where to start.</dd>\n      <dt>Everything else</dt>\n      <dd>Leave enough space for post-booking and marketing content.</dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--1\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 192px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 173.95833333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/d9157903987dd6ed3e27dc2bcb33c49a/8514f/project13.png\" srcset=\"/static/d9157903987dd6ed3e27dc2bcb33c49a/8514f/project13.png 192w\" sizes=\"(max-width: 192px) 100vw, 192px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>How important the search is?</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content project-content--6/4\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #2</b>\n      <h3 class=\"h3\">Exploring the trade-off</h3>\n    </header>\n    <dl>\n      <dt>Option A — Full search</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Give users the complete search interface immediately</li>\n          <li>Trade-off: Secondary content was pushed below the fold, reducing its visibility</li>\n          <li><a href=\"https://projects.invisionapp.com/share/MPNTZTV9RHG#/screens/318101850\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm text-gray-600 button button--link\">Open wireframe</a></li>\n        </ul>\n      </dd>\n      <dt>Option B — Minimal search</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Reduce search to a smaller entry point to preserve more space</li>\n          <li>Trade-off: The reduced UI was less recognizable as a travel search experience</li>\n          <li><a href=\"https://projects.invisionapp.com/share/MPNTZTV9RHG#/screens/317587837\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm text-gray-600 button button--link\">Open wireframe</a></li>\n        </ul>\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--2\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 735px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 181.33333333333331%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/7f9e1c2fa5cfaccb78848fa479a829ae/7608e/project03.png\" srcset=\"/static/7f9e1c2fa5cfaccb78848fa479a829ae/5a46d/project03.png 300w,\n/static/7f9e1c2fa5cfaccb78848fa479a829ae/0a47e/project03.png 600w,\n/static/7f9e1c2fa5cfaccb78848fa479a829ae/7608e/project03.png 735w\" sizes=\"(max-width: 735px) 100vw, 735px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.3: Option A</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 735px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 181.33333333333331%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/a22abda82598bf9e3366e2a1be44818d/7608e/project04.png\" srcset=\"/static/a22abda82598bf9e3366e2a1be44818d/5a46d/project04.png 300w,\n/static/a22abda82598bf9e3366e2a1be44818d/0a47e/project04.png 600w,\n/static/a22abda82598bf9e3366e2a1be44818d/7608e/project04.png 735w\" sizes=\"(max-width: 735px) 100vw, 735px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.4: Option B</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #3</b>\n      <h3 class=\"h3\">Converting the trade-off</h3>\n    </header>\n    <p>\n      <b>Turning it into an interactive crossroads:</b> expanding as the user needed more information\n    </p>\n    <dl>\n      <dt>Option C - Expandable search</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Initial state: communicates the concept of travel search</li>\n          <li>Engaged state: user's action will define path (Typing VS. Scrolling) </li>\n        </ul>\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--block\">\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/038c16fcb7816aa1f4184d89c66d3af8/project10.gif\" alt=\"Project\">\n      <figcaption>Fig.7: Option C search view</figcaption>\n    </figure>\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/bb6cbc9241de9a65bad48f3b79b5349d/project11.gif\" alt=\"Project\">\n      <figcaption>Fig.6: Option C initial view</figcaption>\n    </figure>\n    <figure class=\"project-content__figure project-content__figure--gif\">\n      <img src=\"/39aee784eb2101b53ceb7914a1c34d52/project12.gif\" alt=\"Project\">\n      <figcaption>Fig.6: Option C initial view</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content project-content--5/5\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <b class=\"content-section__eyebrow\">Key Stage #4</b>\n      <h3 class=\"h3\">Final outcome</h3>\n    </header>\n    <dl>\n      <dt>Visual design</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Color distinguishes IA and status of interaction</li>\n          <li>Animation emphasizes visual cue</li>\n        </ul>\n      </dd>\n      <dt>Interaction sequence</dt>\n      <dd>\n        <ol class=\"ordered-list\">\n          <li>Initial view</li>\n          <li>Searching: user enters location &gt; search section enpanded</li>\n          <li>Exploring: user interact other components &gt; moves toward to each path</li>\n        </ol>\n      </dd>\n    </dl>\n    <a href=\"https://preview.uxpin.com/6178e38c68fdc4e35512c57e84b9a96790b8c9b2#/pages//simulate/sitemap?mode=ch\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm text-gray-600 button button--link mt-4\">Open interactive prototype</a>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--2\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/318f39da89520fd400996efbcc924d8d/1d69c/project07.png\" srcset=\"/static/318f39da89520fd400996efbcc924d8d/5a46d/project07.png 300w,\n/static/318f39da89520fd400996efbcc924d8d/0a47e/project07.png 600w,\n/static/318f39da89520fd400996efbcc924d8d/1d69c/project07.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.7: Search view</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/9fed460d618812102a747905e6107e2c/1d69c/project06.png\" srcset=\"/static/9fed460d618812102a747905e6107e2c/5a46d/project06.png 300w,\n/static/9fed460d618812102a747905e6107e2c/0a47e/project06.png 600w,\n/static/9fed460d618812102a747905e6107e2c/1d69c/project06.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.6: Initial view</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <h3 class=\"h3\">Contribution</h3>\n    </header>\n    <dl class=\"project-content__card\">\n      <dt>Product strategy</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Collaborating with product owner for setting the problem statement</li>\n          <li>Setting product design strategy</li>\n        </ul>\n      </dd>\n      <dt>UI design</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Creating a high-fidelity UI mock-up</li>\n          <li>Creating an interactive prototype using Sketch and UXPin</li>\n        </ul>\n      </dd>\n      <dt>UX design</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Collaborating with UX researcher on a benchmarking report and analyzing user behavior, traffic analysis</li>\n          <li>Collaborating in interaction design to create a wireframe</li>\n          <li>Generating an interaction flow and micro-interaction guide</li>\n        </ul>\n      </dd>\n    </dl>\n  </div>\n</div>","frontmatter":{"date":"May, 2018","slug":"/works/1st-project","title":"Flight search redesign","tags":["User Interface","User Experience","Information Archtecture","Prototyping","Micro Interaction","Front-end","@Fareportal"],"impacts":["<strong>4.8%</strong> ⬇️ Bounce Rate","<strong>2.6%</strong> ⬆️ Flight Search Rate","<strong>3.1%</strong> ⬆️ Initial Funnel"],"excerpt":"Making flight search easier to understand without losing the rest of the home experience.","team":"Fareportal","teamUrl":"http://www.fareportal.com/","role":"Mobile design manager","industry":"Travel / Online travel agency","headerFlip":true,"previewLandscape":false,"cover":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#f86868","images":{"fallback":{"src":"/static/741fb1587399b74516313995acf7a1ac/b92ff/project-cover.png","srcSet":"/static/741fb1587399b74516313995acf7a1ac/4b1e5/project-cover.png 150w,\n/static/741fb1587399b74516313995acf7a1ac/a061f/project-cover.png 300w,\n/static/741fb1587399b74516313995acf7a1ac/b92ff/project-cover.png 600w","sizes":"(min-width: 600px) 600px, 100vw"},"sources":[{"srcSet":"/static/741fb1587399b74516313995acf7a1ac/ca576/project-cover.webp 150w,\n/static/741fb1587399b74516313995acf7a1ac/a9a8c/project-cover.webp 300w,\n/static/741fb1587399b74516313995acf7a1ac/5765c/project-cover.webp 600w","type":"image/webp","sizes":"(min-width: 600px) 600px, 100vw"}]},"width":600,"height":340}}},"preview":{"childImageSharp":{"gatsbyImageData":{"layout":"constrained","backgroundColor":"#f8f8f8","images":{"fallback":{"src":"/static/cf43af34e5a33b0a267b8ce7e6ede47e/2ba20/project-preview.png","srcSet":"/static/cf43af34e5a33b0a267b8ce7e6ede47e/cf9e6/project-preview.png 150w,\n/static/cf43af34e5a33b0a267b8ce7e6ede47e/fd946/project-preview.png 300w,\n/static/cf43af34e5a33b0a267b8ce7e6ede47e/2ba20/project-preview.png 600w,\n/static/cf43af34e5a33b0a267b8ce7e6ede47e/7961f/project-preview.png 1200w","sizes":"(min-width: 600px) 600px, 100vw"},"sources":[{"srcSet":"/static/cf43af34e5a33b0a267b8ce7e6ede47e/d9fd3/project-preview.webp 150w,\n/static/cf43af34e5a33b0a267b8ce7e6ede47e/3299a/project-preview.webp 300w,\n/static/cf43af34e5a33b0a267b8ce7e6ede47e/38e3a/project-preview.webp 600w,\n/static/cf43af34e5a33b0a267b8ce7e6ede47e/ee6d9/project-preview.webp 1200w","type":"image/webp","sizes":"(min-width: 600px) 600px, 100vw"}]},"width":600,"height":989}}}}}},"pageContext":{"slug":"/works/1st-project"}},"staticQueryHashes":[],"slicesMap":{}}