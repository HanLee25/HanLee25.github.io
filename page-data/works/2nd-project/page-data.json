nt__column project-content__image project-content__image--1\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 1114px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 74.33333333333333%; position: relative; bottom: 0; left: 0; background-image: url('data:image/jpeg;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/5f702df5654d094672533f679498490d/b3d5a/project06.jpg\" srcset=\"/static/5f702df5654d094672533f679498490d/f93b5/project06.jpg 300w,\n/static/5f702df5654d094672533f679498490d/b4294/project06.jpg 600w,\n/static/5f702df5654d094672533f679498490d/b3d5a/project06.jpg 1114w\" sizes=\"(max-width: 1114px) 100vw, 1114px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.7: Option C search view</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <h3 class=\"h3\">Contribution</h3>\n    </header>\n    <dl class=\"project-content__card\">\n      <dt>Product strategy</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Collaborating with product owner for setting the problem statement</li>\n          <li>Holistic product UX review</li>\n          <li>Setting product design strategy</li>\n        </ul>\n      </dd>\n      <dt>UX design</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Collaborating with UX researcher on analyzing user feedback</li>\n          <li>Create a wireframe with interaction flow</li>\n        </ul>\n      </dd>\n      <dt>UI design</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\