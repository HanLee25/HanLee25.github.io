{"componentChunkName":"component---src-templates-project-template-js","path":"/works/2nd-project/","result":{"data":{"markdownRemark":{"html":"<div class=\"content-section project-content project-content--4/6 project-content--flipped\">\n  <div class=\"project-content__column lg:ml-4 lg:-mr-8 xl:ml-8\">\n    <header class=\"content-section__header\">\n      <h3 class=\"h3\">Probelm area</h3>\n    </header>\n    <dl>\n      <dt>Product issue</dt>\n      <dd>\n        Users abandon the booking path after selecting the flight from the listing\n      </dd>\n      <dt>User Test Finding</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>\"I already selected what I want. I want to book it while it's available.\"</li>\n          <li>\"I need to check overlay details before select the flight.\"</li>\n        </ul>\n      </dd>\n      <dt>Product goal</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Increase listing - booking page funnel</li>\n          <li>Reduce bounce rate during the booking process</li>\n        </ul>\n      </dd>\n      <dt>Design challenge</dt>\n      <dd>\n        Flight details should be available in the booking path but should not compete with tier 1 context of the pages\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--2\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/9d507d0b2039e8069814a7987a9758a9/1d69c/project01.png\" srcset=\"/static/9d507d0b2039e8069814a7987a9758a9/5a46d/project01.png 300w,\n/static/9d507d0b2039e8069814a7987a9758a9/0a47e/project01.png 600w,\n/static/9d507d0b2039e8069814a7987a9758a9/1d69c/project01.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.1: Listing screen</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/1cc9cb36877492207f2d56c96c504b5e/1d69c/project02.png\" srcset=\"/static/1cc9cb36877492207f2d56c96c504b5e/5a46d/project02.png 300w,\n/static/1cc9cb36877492207f2d56c96c504b5e/0a47e/project02.png 600w,\n/static/1cc9cb36877492207f2d56c96c504b5e/1d69c/project02.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.2: Review screen</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <h3 class=\"h3\">Draft solutions</h3>\n    </header>\n    <dl>\n      <dt>Suggestion</dt>\n      <dd>\n        <ol class=\"ordered-list\">\n          <li>Add flight detail screen as a drawer view - linked from both listing and booking</li>\n          <li>Rearrange booking input fields - first booking step</li>\n        </ol>\n      </dd>\n      <dt>Diverge options</dt>\n      <dd>\n        <dl class=\"definition-list bulleted-list\">\n          <dt>Option A</dt>\n          <dd>\n            <ul>\n              <li>Add flight detail screen as a mandatory step: <span class=\"text-red-500\">Listing &gt; Details &gt; Booking</span></li>\n            </ul>\n          </dd>\n          <dt>Option B</dt>\n          <dd>\n            <ul>\n              <li>Add flight detail screen as an optional step: <span class=\"text-red-500\">Listing &gt; <span class=\"text-gray-500\">Details</span> &gt; Booking</span></li>\n            </ul>\n          </dd>\n        </dl>\n      </dd>\n      <dt>Wireframe and user test</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li><span class=\"text-red-500\">6/10 Users</span> reacted positively with <span class=\"text-red-500\">Option B</span></li>\n          <li><span class=\"text-red-500\">2/10 Users</span> reacted positively with <span class=\"text-red-500\">Option A</span></li>\n          <li><span class=\"text-red-500\">2/10 Users</span> reacted neutral</li>\n          <li><a href=\"https://preview.uxpin.com/1b5bd2839b4c6429c7afafa3b8b43b31eceee645ch\" target=\"_blank\" rel=\"noreferrer\" class=\"text-sm text-gray-600\">Open option B wireframe</a></li>\n        </ul>\n      </dd>\n    </dl>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--block\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/4901ef668cebead3ea90eaf42dce3b93/1d69c/project03.png\" srcset=\"/static/4901ef668cebead3ea90eaf42dce3b93/5a46d/project03.png 300w,\n/static/4901ef668cebead3ea90eaf42dce3b93/0a47e/project03.png 600w,\n/static/4901ef668cebead3ea90eaf42dce3b93/1d69c/project03.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.3: Listing wireframe</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/6c267ab3e7cc20cba16f401aa804c34a/1d69c/project04.png\" srcset=\"/static/6c267ab3e7cc20cba16f401aa804c34a/5a46d/project04.png 300w,\n/static/6c267ab3e7cc20cba16f401aa804c34a/0a47e/project04.png 600w,\n/static/6c267ab3e7cc20cba16f401aa804c34a/1d69c/project04.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.4: Detail wireframe</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/dc520afff188cbb9ff51a1060b2949ef/1d69c/project05.png\" srcset=\"/static/dc520afff188cbb9ff51a1060b2949ef/5a46d/project05.png 300w,\n/static/dc520afff188cbb9ff51a1060b2949ef/0a47e/project05.png 600w,\n/static/dc520afff188cbb9ff51a1060b2949ef/1d69c/project05.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.5: Booking wireframe</figcaption>\n    </figure>\n  </div>\n</div>\n<div class=\"content-section project-content\">\n  <div class=\"project-content__column\">\n    <header class=\"content-section__header\">\n      <h3 class=\"h3\">Converge and Prototype</h3>\n    </header>\n    <dl>\n      <dt>Visual design</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Emphasize critical information (stops, alternate airport, etc.)</li>\n          <li>Clarify the group of information using spacing, background-color</li>\n          <li>Build a card component for consistent section</li>\n        </ul>\n      </dd>\n      <dt>Visual cues</dt>\n      <dd>\n        <ul class=\"bulleted-list\">\n          <li>Navigating icon: <span class=\"text-red-500\">back vs. close</span></li>\n          <li>Timeline icon: <span class=\"text-red-500\">point a vs. point b</span></li>\n          <li>Highlighted text: critical information</li>\n          <li>Status code: <span class=\"text-red-500\">filled (active) vs empty (inactive)</span></li>\n        </ul>\n      </dd>\n    </dl>\n    <a href=\"https://preview.uxpin.com/8024107a9a5d61961f769228aecf94aa73f2ce60#/pages//simulate/sitemap?mode=ch\" target=\"_blank\" rel=\"noreferrer\" class=\"button button--ghost button--sm mt-4\">Open interactive prototype</a>\n  </div>\n  <div class=\"project-content__column project-content__image project-content__image--block\">\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/88f6143421c7be8fda5b5d723717744f/1d69c/project07.png\" srcset=\"/static/88f6143421c7be8fda5b5d723717744f/5a46d/project07.png 300w,\n/static/88f6143421c7be8fda5b5d723717744f/0a47e/project07.png 600w,\n/static/88f6143421c7be8fda5b5d723717744f/1d69c/project07.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcaption>Fig.6: Listing screen</figcaption>\n    </figure>\n    <figure class=\"project-content__figure\">\n      <span class=\"gatsby-resp-image-wrapper\" style=\"position: relative; display: block; margin-left: auto; margin-right: auto; max-width: 750px; \">\n      <span class=\"gatsby-resp-image-background-image\" style=\"padding-bottom: 216.33333333333334%; position: relative; bottom: 0; left: 0; background-image: url('data:image/png;base64,'); background-size: cover; display: block;\"></span>\n  <img class=\"gatsby-resp-image-image\" alt=\"Project\" title=\"\" src=\"/static/9d684095415dad1201e25875ddffc508/1d69c/project08.png\" srcset=\"/static/9d684095415dad1201e25875ddffc508/5a46d/project08.png 300w,\n/static/9d684095415dad1201e25875ddffc508/0a47e/project08.png 600w,\n/static/9d684095415dad1201e25875ddffc508/1d69c/project08.png 750w\" sizes=\"(max-width: 750px) 100vw, 750px\" style=\"width:100%;height:100%;margin:0;vertical-align:middle;position:absolute;top:0;left:0;\" loading=\"lazy\" decoding=\"async\">\n    </span>\n      <figcapti