{
  "name": "gatsby-tailwind-portfolio",
  "description": "Product designer, illustrator, and front-end developer who values the visual storytelling method",
  "version": "4.0.0",
  "author": "Han Lee <hi2hanlee@gmail.com>",
  "engines": {
    "node": ">=20 <26"
  },
  "dependencies": {
    "@svgr/webpack": "8.1.0",
    "gatsby": "5.16.1",
    "gatsby-plugin-anchor-links": "1.2.1",
    "gatsby-plugin-google-analytics": "5.16.0",
    "gatsby-plugin-image": "3.16.0",
    "gatsby-plugin-manifest": "5.16.0",
    "gatsby-plugin-offline": "6.16.0",
    "gatsby-plugin-postcss": "6.16.0",
    "gatsby-plugin-sharp": "5.16.0",
    "gatsby-plugin-svgr": "3.0.0-beta.0",
    "gatsby-remark-copy-linked-files": "6.16.0",
    "gatsby-remark-images": "7.16.0",
    "gatsby-source-filesystem": "5.16.0",
    "gatsby-transformer-remark": "6.16.0",
    "gatsby-transformer-sharp": "5.16.0",
    "gsap": "^3.4.2",
    "prop-types": "15.7.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "keywords": [
    "gatsby",
    "tailwind",
    "tailwindcss",
    "purgecss"
  ],
  "license": "MIT",
  "scripts": {
    "analyze:lint": "eslint --ext .jsx --ext .js .",
    "analyze:prettier": "prettier --list-different \"**/*.{css,js,jsx,json,md}\"",
    "analyze": "npm run analyze:lint && npm run analyze:prettier",
    "fix:lint": "eslint --ext .jsx --ext .js . --fix",
    "fix:prettier": "prettier --write \"**/*.{css,js,jsx,json,md}\"",
    "fix": "npm run fix:lint && npm run fix:prettier",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "dev": "npm run develop",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "deploy": "gatsby build && gh-pages -d public -b master",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "cssnano": "9.3.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "gh-pages": "6.1.1",
    "prettier": "2.0.5",
    "tailwindcss": "4.3.3"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:react/recommended"
    ],
    "env": {
      "browser": true,
      "es2021": true,
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": 2021,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/prop-types": "off",
      "react/no-unescaped-entities": "off"
    }
  },
  "overrides": {
    "gatsby": {
      "cookie": "0.7.2",
      "path-to-regexp": "0.1.13"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/taylorbryant/gatsby-starter-tailwind"
  },
  "bugs": {
    "url": "https://github.com/taylorbryant/gatsby-starter-tailwind/issues"
  }
}
